---
import Icon from './Icon.astro';
import { site, whatsappLink } from '../data/site';
const wa = whatsappLink('Merhaba, web sitenizden ulaşıyorum. Bilgi almak istiyorum.');
---

<a href={wa} class="wa-float" target="_blank" rel="noopener" aria-label="WhatsApp'tan yazın">
  <Icon name="whatsapp" size={26} strokeWidth={1.7} />
  <span class="wa-tip">WhatsApp'tan yazın</span>
</a>

<nav class="mobile-bar" aria-label="Hızlı iletişim">
  <a href={site.phoneHref}><Icon name="phone" size={20} /><span>Ara</span></a>
  <a href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" size={21} /><span>WhatsApp</span></a>
  <a href="/randevu-olustur/" class="primary"><Icon name="calendar" size={20} /><span>Randevu Oluştur</span></a>
</nav>

<style>
  /* Sağ alt köşede site asistanı durur; WhatsApp butonu onun hemen üstündedir. */
  .wa-float {
    position: fixed;
    right: calc(clamp(16px, 2.4vw, 28px) + 3px);
    bottom: calc(clamp(16px, 2.4vw, 28px) + 72px);
    z-index: 40;
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: var(--sage-800);
    color: #fff;
    box-shadow: 0 14px 30px -12px rgb(41 44 41 / 0.55);
    transition:
      transform 0.2s ease,
      background-color 0.2s ease;
  }
  .wa-float:hover {
    transform: translateY(-2px);
    background: var(--sage-900);
  }
  .wa-tip {
    position: absolute;
    right: calc(100% + 12px);
    top: 50%;
    transform: translateY(-50%);
    background: var(--ink);
    color: var(--ivory);
    font-size: 0.82rem;
    font-weight: 600;
    white-space: nowrap;
    padding: 0.45em 0.8em;
    border-radius: 10px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  .wa-float:hover .wa-tip,
  .wa-float:focus-visible .wa-tip {
    opacity: 1;
  }

  .mobile-bar {
    display: none;
  }

  @media (max-width: 760px) {
    .wa-float {
      display: none;
    }
    .mobile-bar {
      position: fixed;
      inset: auto 0 0 0;
      z-index: 45;
      display: grid;
      grid-template-columns: 1fr 1fr 1.5fr;
      gap: 8px;
      padding: 8px 10px calc(8px + env(safe-area-inset-bottom));
      background: rgb(251 248 242 / 0.96);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-top: 1px solid rgb(41 44 41 / 0.08);
      box-shadow: 0 -10px 30px -20px rgb(41 44 41 / 0.4);
    }
    .mobile-bar a {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      min-height: 48px;
      border-radius: 14px;
      background: var(--sage-100);
      color: var(--ink);
      font-size: 0.86rem;
      font-weight: 700;
      text-decoration: none;
    }
    .mobile-bar a.primary {
      background: var(--terracotta-700);
      color: #fff;
    }
  }
</style>
