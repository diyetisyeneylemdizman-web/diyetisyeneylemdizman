---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import LeafDecor from '../components/LeafDecor.astro';
---

<BaseLayout title="Sayfa bulunamadı" noindex>
  <section class="section nf">
    <LeafDecor class="nf-leaf" />
    <div class="container-narrow nf-inner">
      <p class="code">404</p>
      <h1>Aradığınız sayfayı bulamadık</h1>
      <p class="lead">Sayfa taşınmış ya da adresi yanlış yazılmış olabilir. Aşağıdaki bağlantılardan devam edebilirsiniz.</p>
      <div class="links">
        <a href="/" class="btn btn-primary"><Icon name="arrowRight" size={18} />Ana Sayfa</a>
        <a href="/hizmetler/" class="btn btn-outline">Hizmetler</a>
        <a href="/randevu-olustur/" class="btn btn-outline">Randevu Oluştur</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    position: relative;
    overflow: hidden;
    text-align: center;
    min-height: 60vh;
    display: grid;
    align-items: center;
  }
  .nf :global(.nf-leaf) {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 320px;
    transform: translate(-50%, -50%) rotate(12deg);
    color: var(--sage-200);
    opacity: 0.7;
  }
  .nf-inner {
    position: relative;
  }
  .code {
    font-family: var(--font-serif);
    font-size: clamp(4rem, 12vw, 7rem);
    line-height: 1;
    color: var(--terracotta);
    margin-bottom: 0.2em;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-top: 28px;
  }
</style>
