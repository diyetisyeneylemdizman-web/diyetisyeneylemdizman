---
import PortalLayout from '../../../layouts/PortalLayout.astro';
---

<PortalLayout title="Şifre Yenileme" alan="danisan">
  <div class="auth">
    <div class="card auth-kart">
      <h1>Yeni Şifre Belirleyin</h1>
      <p data-aciklama>Diyetisyeninizin gönderdiği bağlantı 48 saat geçerlidir ve yalnızca bir kez kullanılabilir.</p>
      <form class="form-grid" novalidate data-yenile>
        <p class="form-hata" data-form-hata hidden role="alert"></p>
        <div class="field">
          <label for="sifre">Yeni Şifre</label>
          <input class="input" id="sifre" name="sifre" type="password" autocomplete="new-password" required data-alan="Şifre" />
          <p class="hint">En az 8 karakter; en az bir harf ve bir rakam.</p>
        </div>
        <div class="field">
          <label for="sifre2">Yeni Şifre (Tekrar)</label>
          <input class="input" id="sifre2" type="password" autocomplete="new-password" required data-alan="Şifre tekrar" />
        </div>
        <button type="submit" class="btn btn-primary btn-block">Şifremi Kaydet</button>
      </form>
      <div data-tamam hidden>
        <p class="bilgi-kutu">Şifreniz güncellendi. Yeni şifrenizle giriş yapabilirsiniz.</p>
        <a href="/danisan/giris/" class="btn btn-primary btn-block">Giriş Yap</a>
      </div>
    </div>
  </div>
</PortalLayout>

<script>
  import { api, ApiError, durumBandi, formHatasi, formTemizle, mesgul } from '../../../scripts/portal/lib';

  durumBandi();
  // Bağlantıdaki anahtar adres çubuğundan hemen silinir (geçmişte ve ekran paylaşımında görünmesin)
  const bilet = location.hash.slice(1);
  if (bilet) history.replaceState(null, '', location.pathname);
  const form = document.querySelector<HTMLFormElement>('[data-yenile]')!;
  if (!bilet) formHatasi(form, new ApiError(400, 'Bağlantı eksik. Diyetisyeninizin gönderdiği bağlantıyı açın.'));

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    formTemizle(form);
    const s = form.querySelector<HTMLInputElement>('#sifre')!.value;
    const s2 = form.querySelector<HTMLInputElement>('#sifre2')!.value;
    if (s !== s2) return formHatasi(form, new ApiError(400, 'Şifreler aynı değil.', 'Şifre tekrar'));
    mesgul(form.querySelector('button'), async () => {
      try {
        await api('POST', '/sifre-yenile', { bilet, sifre: s });
        form.hidden = true;
        document.querySelector<HTMLElement>('[data-tamam]')!.hidden = false;
      } catch (err) {
        formHatasi(form, err);
      }
    });
  });
</script>
