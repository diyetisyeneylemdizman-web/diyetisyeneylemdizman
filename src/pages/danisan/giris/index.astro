---
import PortalLayout from '../../../layouts/PortalLayout.astro';
import { site, whatsappLink } from '../../../data/site';
const sifreTalebi = whatsappLink('Merhaba, danışan paneli şifremi yenilemek için bağlantı rica ediyorum.');
---

<PortalLayout title="Danışan Girişi" alan="danisan">
  <div class="auth">
    <div class="card auth-kart">
      <h1>Danışan Girişi</h1>
      <p>Paketinizi, ölçümlerinizi, randevularınızı ve belgelerinizi danışan panelinden takip edebilirsiniz.</p>
      <form class="form-grid" novalidate data-giris>
        <p class="form-hata" data-form-hata hidden role="alert"></p>
        <div class="field">
          <label for="kimlik">E-posta veya Telefon</label>
          <input class="input" id="kimlik" name="kimlik" autocomplete="username" required data-alan="E-posta veya telefon" />
        </div>
        <div class="field">
          <label for="sifre">Şifre</label>
          <input class="input" id="sifre" name="sifre" type="password" autocomplete="current-password" required />
        </div>
        <button type="submit" class="btn btn-primary btn-block">Giriş Yap</button>
      </form>
      <p class="form-alt">Hesabınız yok mu? <a href="/danisan/kayit/">Üye Olun</a></p>
      <details class="form-alt">
        <summary>Şifremi unuttum</summary>
        <p>
          Güvenliğiniz için şifre yenileme bağlantısı diyetisyeniniz tarafından WhatsApp üzerinden iletilir. Bağlantı 48
          saat geçerlidir.
        </p>
        <a href={sifreTalebi} target="_blank" rel="noopener" class="btn btn-wa btn-sm">WhatsApp’tan Bağlantı İste</a>
      </details>
      <p class="form-alt">
        Danışan paneli isteğe bağlıdır; beslenme danışmanlığı panel kullanılmadan da alınabilir. Sorularınız için:
        <a href={site.phoneHref}>{site.phoneDisplay}</a>
      </p>
    </div>
  </div>
</PortalLayout>

<script>
  import { api, durumBandi, formHatasi, formTemizle, mesgul } from '../../../scripts/portal/lib';

  durumBandi();
  api('GET', '/ben')
    .then(() => location.replace('/danisan/'))
    .catch(() => {});

  const form = document.querySelector<HTMLFormElement>('[data-giris]')!;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    formTemizle(form);
    const data = new FormData(form);
    mesgul(form.querySelector('button'), async () => {
      try {
        await api('POST', '/giris', { kimlik: data.get('kimlik'), sifre: data.get('sifre') });
        location.replace('/danisan/');
      } catch (err) {
        formHatasi(form, err);
      }
    });
  });
</script>
