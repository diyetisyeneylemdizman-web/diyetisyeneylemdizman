---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { serviceAreas, servicesIntro, servicesCta } from '../data/services';
import { paketGruplari } from '../data/packages';

const randevu = (name: string) => `/randevu-olustur/?hizmet=${encodeURIComponent(name)}#randevu-formu`;
// Hizmet alanının paketi varsa bölüm başlığının altında Paketler sayfasına bağlantı gösterilir
const paketi = (alan: string) => paketGruplari.find((p) => p.alan === alan);
---

<BaseLayout
  title="Hizmetler"
  description="Beslenme danışmanlığı ve takip, kilo yönetimi, metabolik ve hormonal sağlık, sindirim sistemi, besin alerjisi ve intoleranslar, deri sağlığı, kalp-damar sağlığı ve yaşam dönemlerinde beslenme."
>
  <PageHero
    title="Hizmetler"
    eyebrow="Hizmet Alanları"
    lead="Kilo yönetimi, hastalıklarda beslenme ve özel dönemlerde size özel danışmanlık ve takip desteği."
    crumbs={[{ label: 'Hizmetler' }]}
  >
    <nav class="cat-nav" aria-label="Hizmet alanları">
      {
        serviceAreas.map((a) => (
          <a href={`#${a.id}`} class="chip">
            <Icon name={a.icon} size={16} />
            {a.short}
          </a>
        ))
      }
    </nav>
  </PageHero>

  <section class="section-sm intro">
    <div class="container-narrow">
      <div class="section-head center">
        <p class="eyebrow">{servicesIntro.eyebrow}</p>
        <h2>{servicesIntro.title}</h2>
      </div>
      {servicesIntro.paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </section>

  {
    serviceAreas.map((a, i) => {
      const introInBody = !a.items && !a.list;
      const stacked = a.items?.some((it) => it.list);
      const compact = a.items?.every((it) => !it.text && !it.list);
      return (
        <section id={a.id} class:list={['section-sm', 'area', { 'bg-paper': i % 2 === 0 }]}>
          <div class="container area-grid">
            <header class="area-head">
              <div class="area-badges">
                <span class="icon-badge">
                  <Icon name={a.icon} size={26} />
                </span>
                <span class="area-no" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
              </div>
              <h2>{a.title}</h2>
              {!introInBody && a.intro?.map((p) => <p>{p}</p>)}
              {paketi(a.id) && (
                <a href={`/paketler/#${paketi(a.id)!.id}`} class="link-arrow paket-link">
                  Paketleri incele <Icon name="arrowRight" size={17} />
                </a>
              )}
            </header>

            <div class="area-body">
              {a.items && (
                <div class:list={['item-grid', { stacked, compact }]}>
                  {a.items.map((it) => (
                    <article id={it.slug} class="svc reveal">
                      <h3>{it.title ?? it.name}</h3>
                      {it.text && <p>{it.text}</p>}
                      {it.list && (
                        <ul class="ticks">
                          {it.list.map((li) => (
                            <li>
                              <Icon name="check" size={18} />
                              {li}
                            </li>
                          ))}
                        </ul>
                      )}
                      {it.note && (
                        <p class="note">
                          <Icon name="info" size={16} />
                          {it.note}
                        </p>
                      )}
                      {it.randevu !== false && (
                        <a href={randevu(it.name)} class="link-arrow">
                          Randevu Talebi Oluştur <Icon name="arrowRight" size={17} />
                        </a>
                      )}
                    </article>
                  ))}
                </div>
              )}

              {!a.items && (
                <div class="svc single reveal">
                  {introInBody && a.intro?.map((p) => <p>{p}</p>)}
                  {a.list && (
                    <ul class="ticks">
                      {a.list.map((li) => (
                        <li>
                          <Icon name="check" size={18} />
                          {li}
                        </li>
                      ))}
                    </ul>
                  )}
                  {a.outro && <p class="outro">{a.outro}</p>}
                  {a.note && (
                    <p class="note">
                      <Icon name="info" size={16} />
                      {a.note}
                    </p>
                  )}
                  <a href={randevu(a.name ?? a.short)} class="link-arrow">
                    Randevu Talebi Oluştur <Icon name="arrowRight" size={17} />
                  </a>
                </div>
              )}

              {a.items && a.outro && <p class="outro after">{a.outro}</p>}
              {a.items && a.note && (
                <p class="note after">
                  <Icon name="info" size={16} />
                  {a.note}
                </p>
              )}
            </div>
          </div>
        </section>
      );
    })
  }

  <CtaBand title={servicesCta.title} text={servicesCta.text} />
</BaseLayout>

<style>
  .cat-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }
  .cat-nav a {
    text-decoration: none;
    background: var(--paper);
    border: 1px solid var(--beige);
    padding: 0.55em 1em;
  }
  .cat-nav a:hover {
    border-color: var(--sage);
  }
  .intro p:not(.eyebrow) {
    color: var(--ink-2);
  }
  .intro .section-head {
    margin-bottom: 20px;
  }
  .area {
    scroll-margin-top: calc(var(--header-h) + 8px);
  }
  .area-grid {
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
  }
  .area-head {
    position: sticky;
    top: calc(var(--header-h) + 24px);
  }
  .area-badges {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .area-no {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--terracotta-700);
    letter-spacing: 0.04em;
  }
  .area-head h2 {
    margin-top: 18px;
    font-size: clamp(1.7rem, 2.8vw, 2.25rem);
  }
  .area-head p {
    color: var(--ink-2);
  }
  .paket-link {
    margin-top: 6px;
  }
  .item-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .item-grid.stacked {
    grid-template-columns: 1fr;
  }
  .svc {
    scroll-margin-top: calc(var(--header-h) + 24px);
    background: var(--ivory-soft);
    border: 1px solid var(--beige);
    border-radius: var(--radius-lg);
    padding: 24px;
    display: flex;
    flex-direction: column;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .bg-paper .svc {
    background: var(--ivory);
  }
  .svc:target {
    border-color: var(--terracotta);
    box-shadow: 0 0 0 4px rgb(185 120 98 / 0.15);
  }
  .svc:hover {
    border-color: var(--sage);
  }
  .svc h3 {
    font-size: 1.2rem;
    margin-bottom: 8px;
  }
  .svc p {
    color: var(--ink-2);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .svc > p:last-of-type {
    margin-bottom: 18px;
  }
  .svc .link-arrow {
    margin-top: auto;
  }
  .compact .svc h3 {
    margin-bottom: 14px;
  }
  .svc.single {
    font-size: 0.95rem;
  }
  .ticks {
    list-style: none;
    padding: 0;
    margin: 4px 0 18px;
    display: grid;
    gap: 10px;
  }
  .ticks li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    color: var(--ink-2);
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .ticks :global(svg) {
    flex: none;
    margin-top: 2px;
    color: var(--sage-700);
  }
  .note {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    font-size: 0.88rem !important;
    background: var(--sage-50);
    border-radius: 14px;
    padding: 12px 14px;
  }
  .note :global(svg) {
    flex: none;
    margin-top: 3px;
    color: var(--sage-700);
  }
  .outro.after,
  .note.after {
    margin-top: 18px;
    margin-bottom: 0;
  }
  .outro.after {
    color: var(--ink-2);
  }
  @media (max-width: 900px) {
    .area-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .area-head {
      position: static;
    }
  }
  @media (max-width: 620px) {
    .item-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
