---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
import Yonlendir from '../layouts/Yonlendir.astro';
import { takibimAcik, portalBelgeleri } from '../data/portal';
// Takibim kapalıyken (src/data/portal.ts → takibimAcik) bu sayfa KVKK Aydınlatma Metni'ne yönlenir.
// NOT: Bu metin genel bir şablondur; hukukçu kontrolü önerilir. Metin değiştiğinde src/data/portal.ts içindeki
// "acikRiza" sürümü güncellenmelidir (Takibim kullanan danışanlar bir sonraki açılışta yeniden onay verir).
const b = portalBelgeleri.acikRiza;
const guncelleme = b.guncelleme.split('-').reverse().join('.');
---

{
  takibimAcik ? (
    <BaseLayout
      title="Takibim İçin Açık Rıza Metni"
      description="Diyetisyen Eylem Dizman Takibim sayfasında sağlık verilerinin işlenmesine ilişkin açık rıza metni."
    >
      <PageHero
        title="Takibim İçin Açık Rıza Metni"
        eyebrow="Sağlık Verileri"
        crumbs={[{ label: 'KVKK Aydınlatma Metni', href: portalBelgeleri.aydinlatma.yol }, { label: 'Açık Rıza Metni' }]}
      />

      <section class="section">
        <div class="container-narrow prose">
          <p class="surum">Son güncelleme: {guncelleme} · Sürüm {b.surum}</p>
          <p>
            <a href={portalBelgeleri.aydinlatma.yol}>KVKK Aydınlatma Metni</a>’ni okudum. Veri sorumlusu
            <strong>Eylem Dizman</strong> ({site.clinicName}) tarafından, Takibim hizmeti kapsamında;
          </p>
          <ul>
            <li>
              adım, cinsiyetim, boyum ve hedef kilom ile <strong>sağlık verilerimin</strong> (kilo ve vücut analizi sonuçlarım,
              kol, bacak ve gövde için segmental ölçümlerim, bel ve kalça çevrem), paket ve randevu bilgilerimin, diyetisyenimin
              bana gönderdiği beslenme planları, vücut analizi raporları ve mesajların,
            </li>
            <li>
              ölçümlerimin ve gelişimimin telefonumda gösterilmesi, beslenme planlarımın ve belgelerimin bana iletilmesi ve
              diyetisyenim yeni sonuç eklediğinde telefonumdaki bilgilerin güncellenmesi amacıyla,
            </li>
            <li>
              diyetisyenimin bilgisayarında bana özel bir anahtarla şifrelenerek sitenin barındırıldığı hizmet sağlayıcının
              sunucusunda <strong>uçtan uca şifreli</strong> olarak saklanmasına ve yalnızca telefonumda çözülerek
              görüntülenmesine
            </li>
          </ul>
          <p>açık rızam ile onay veriyorum.</p>

          <h2>Bilmeniz gerekenler</h2>
          <ul>
            <li>
              <strong>Açık rıza isteğe bağlıdır.</strong> Rıza vermezseniz yalnızca Takibim kullanılamaz; beslenme
              danışmanlığı hizmetinizi klinikte veya online görüşmelerle aynı şekilde almaya devam edersiniz.
            </li>
            <li>
              <strong>Hastalık, ilaç, alerji bilgileriniz ve diyetisyenin özel notları Takibim’e gönderilmez.</strong> Bu bilgiler
              yalnızca diyetisyenin kendi bilgisayarındaki şifreli kayıtlarda durur.
            </li>
            <li>
              <strong>Rızanızı istediğiniz zaman geri çekebilirsiniz:</strong> Takibim → Ayarlar → “Takibimi Kapat” ile, diyetisyeninize
              söyleyerek veya <a href={`mailto:${site.email}`}>{site.email}</a> adresine yazarak. Geri çektiğinizde sunucudaki
              şifreli verileriniz ve belgeleriniz silinir; geri çekme, o ana kadar yapılan işlemleri etkilemez.
            </li>
            <li>
              Barındırma hizmet sağlayıcısı ve verilerin şifrelenmesi hakkında ayrıntılar
              <a href={`${portalBelgeleri.aydinlatma.yol}#takibim`}>Aydınlatma Metni</a>’nde açıklanmıştır.
            </li>
            <li>18 yaşından küçükler için bu onay veli veya vasi tarafından verilir ve Takibim velinin telefonunda açılır.</li>
          </ul>
        </div>
      </section>
    </BaseLayout>
  ) : (
    <Yonlendir hedef={portalBelgeleri.aydinlatma.yol} />
  )
}


<style>
  .surum {
    color: var(--ink-3);
    font-size: 0.9rem;
  }
</style>
