---
import PortalLayout from '../../../layouts/PortalLayout.astro';
---

<PortalLayout title="Diyetisyen Paneli Kurulumu" alan="yonetim">
  <div class="auth genis">
    <div class="card auth-kart" data-kurulum>
      <h1>Diyetisyen Paneli Kurulumu</h1>
      <p class="yukleniyor" data-yukleniyor>Kontrol ediliyor…</p>

      <!-- A: Cloudflare ayarları eksik -->
      <section data-bolum="ayar" hidden>
        <p class="bilgi-kutu uyari">
          Danışan sisteminin çalışması için Cloudflare panelinde iki gizli değişken tanımlanmalıdır. Bu işlem bir kez
          yapılır ve ücretsizdir.
        </p>
        <ol class="kurulum-adim">
          <li>
            <strong>Veri anahtarı oluşturun.</strong> Aşağıdaki düğme, bu bilgisayarda rastgele bir anahtar üretir (anahtar
            hiçbir yere gönderilmez).
            <div class="eylemler" style="margin:10px 0">
              <button type="button" class="btn btn-sage btn-sm" data-uret="anahtar">Veri Anahtarı Oluştur</button>
              <button type="button" class="btn btn-outline btn-sm" data-kopyala="anahtar" hidden>Kopyala</button>
            </div>
            <p class="kod-kutu" data-deger="anahtar" hidden></p>
            <p class="bilgi-kutu uyari">
              <span>
                <strong>Önemli:</strong> Bu anahtarı güvenli bir yerde (örneğin şifre yöneticisinde) saklayın. Danışan
                bilgileri bu anahtarla şifrelenir; anahtar kaybolur veya değiştirilirse kayıtlı bilgiler okunamaz.
              </span>
            </p>
          </li>
          <li>
            <strong>Kurulum kodu belirleyin.</strong> Yönetici hesabını kurmak ve iki adımlı doğrulamayı sıfırlamak için
            kullanılır (deneme sürümünde deneme kaydı için de).
            <div class="eylemler" style="margin:10px 0">
              <button type="button" class="btn btn-sage btn-sm" data-uret="kod">Kurulum Kodu Oluştur</button>
              <button type="button" class="btn btn-outline btn-sm" data-kopyala="kod" hidden>Kopyala</button>
            </div>
            <p class="kod-kutu" data-deger="kod" hidden></p>
          </li>
          <li>
            Cloudflare panelinde <strong>Workers &amp; Pages → diyetisyeneylemdizman → Settings → Variables and Secrets →
            Add</strong> adımlarını izleyin. Türü <strong>Secret</strong> seçip iki değişken ekleyin:
            <code>VERI_ANAHTARI</code> (1. adımdaki anahtar) ve <code>KURULUM_KODU</code> (2. adımdaki kod). Ardından
            <strong>Deploy</strong> düğmesine basın.
          </li>
          <li>Bu sayfayı yenileyin.</li>
        </ol>
      </section>

      <!-- B: Yönetici hesabı oluşturma -->
      <form class="form-grid" novalidate data-bolum="kurulum" hidden>
        <p class="form-hata" data-form-hata hidden role="alert"></p>
        <p>Diyetisyen paneline giriş yapacak hesabı oluşturun. Girişte şifreye ek olarak telefondaki doğrulama kodu istenir.</p>
        <div class="field">
          <label for="kod">Kurulum Kodu</label>
          <input class="input" id="kod" name="kod" autocomplete="off" required data-alan="Kurulum kodu" />
        </div>
        <div class="form-grid iki">
          <div class="field">
            <label for="ad">Ad Soyad</label>
            <input class="input" id="ad" name="ad" value="Eylem Dizman" required data-alan="Ad Soyad" />
          </div>
          <div class="field">
            <label for="eposta">E-posta</label>
            <input class="input" id="eposta" name="eposta" type="email" autocomplete="username" required data-alan="E-posta" />
          </div>
          <div class="field">
            <label for="sifre">Şifre</label>
            <input class="input" id="sifre" name="sifre" type="password" autocomplete="new-password" required data-alan="Şifre" />
            <p class="hint">En az 12 karakter; en az bir harf ve bir rakam.</p>
          </div>
          <div class="field">
            <label for="sifre2">Şifre (Tekrar)</label>
            <input class="input" id="sifre2" type="password" autocomplete="new-password" required data-alan="Şifre tekrar" />
          </div>
        </div>
        <button type="submit" class="btn btn-primary">Devam</button>
      </form>

      <!-- C: Kurulum tamam / iki adımlı doğrulamayı sıfırlama -->
      <section data-bolum="tamam" hidden>
        <p class="bilgi-kutu">Yönetici hesabı kurulmuş. <a href="/yonetim/giris/" class="metin-dugme">Giriş sayfasına git</a></p>
        <h2>Telefonumu Değiştirdim / Kaybettim</h2>
        <p>Doğrulama uygulamasını yeni telefona kurmak için kurulum kodu, e-posta ve şifrenizle doğrulamayı sıfırlayın.</p>
        <form class="form-grid" novalidate data-sifirla id="sifirla">
          <p class="form-hata" data-form-hata hidden role="alert"></p>
          <div class="form-grid uc">
            <div class="field">
              <label for="skod">Kurulum Kodu</label>
              <input class="input" id="skod" name="kod" autocomplete="off" required data-alan="Kurulum kodu" />
            </div>
            <div class="field">
              <label for="seposta">E-posta</label>
              <input class="input" id="seposta" name="eposta" type="email" autocomplete="username" required data-alan="E-posta" />
            </div>
            <div class="field">
              <label for="ssifre">Şifre</label>
              <input class="input" id="ssifre" name="sifre" type="password" autocomplete="current-password" required />
            </div>
          </div>
          <button type="submit" class="btn btn-outline">Doğrulamayı Sıfırla</button>
        </form>
      </section>

      <!-- D: Doğrulama uygulamasını bağlama -->
      <form class="form-grid" novalidate data-bolum="dogrula" hidden>
        <p class="form-hata" data-form-hata hidden role="alert"></p>
        <h2>Telefonu Bağlayın</h2>
        <ol class="kurulum-adim">
          <li>Telefonunuza <strong>Google Authenticator</strong> veya <strong>Microsoft Authenticator</strong> uygulamasını (ücretsiz) kurun.</li>
          <li>Uygulamada “Hesap ekle / QR kodu tara” seçeneğiyle aşağıdaki kodu okutun.</li>
          <li>Uygulamada görünen 6 haneli kodu yazın.</li>
        </ol>
        <div class="qr" data-qr></div>
        <p class="hint" style="text-align:center">QR okutamıyorsanız anahtarı elle girin:</p>
        <p class="kod-kutu" data-anahtar style="text-align:center"></p>
        <div class="field">
          <label for="dkod">Doğrulama Kodu</label>
          <input class="input" id="dkod" name="kod" inputmode="numeric" autocomplete="one-time-code" maxlength="6" required data-alan="Doğrulama kodu" />
        </div>
        <button type="submit" class="btn btn-primary">Kurulumu Tamamla</button>
      </form>
    </div>
  </div>
</PortalLayout>

<script>
  import qrcode from 'qrcode-generator';
  import { api, ApiError, durumBandi, formHatasi, formNesnesi, formTemizle, mesgul } from '../../../scripts/portal/lib';

  const kok = document.querySelector<HTMLElement>('[data-kurulum]')!;
  const bolum = (ad: string) => {
    kok.querySelectorAll<HTMLElement>('[data-bolum]').forEach((b) => (b.hidden = b.dataset.bolum !== ad));
    kok.querySelector<HTMLElement>('[data-yukleniyor]')!.hidden = true;
  };
  let bilet = '';

  const b64 = (bytes: Uint8Array) => btoa(String.fromCharCode(...bytes));
  kok.querySelectorAll<HTMLButtonElement>('[data-uret]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const tur = btn.dataset.uret!;
      const deger =
        tur === 'anahtar'
          ? b64(crypto.getRandomValues(new Uint8Array(32)))
          : Array.from(crypto.getRandomValues(new Uint8Array(12)), (b) => 'abcdefghjkmnpqrstuvwxyz23456789'[b % 31]).join('').replace(/(.{4})(?!$)/g, '$1-');
      const kutu = kok.querySelector<HTMLElement>(`[data-deger="${tur}"]`)!;
      kutu.textContent = deger;
      kutu.hidden = false;
      kok.querySelector<HTMLElement>(`[data-kopyala="${tur}"]`)!.hidden = false;
    }),
  );
  kok.querySelectorAll<HTMLButtonElement>('[data-kopyala]').forEach((btn) =>
    btn.addEventListener('click', async () => {
      const deger = kok.querySelector<HTMLElement>(`[data-deger="${btn.dataset.kopyala}"]`)!.textContent ?? '';
      try {
        await navigator.clipboard.writeText(deger);
        btn.textContent = 'Kopyalandı';
      } catch {
        btn.textContent = 'Seçip kopyalayın';
      }
    }),
  );

  const qrGoster = (r: { bilet: string; anahtar: string; otpauth: string }) => {
    bilet = r.bilet;
    const qr = qrcode(0, 'M');
    qr.addData(r.otpauth);
    qr.make();
    const svg = new DOMParser().parseFromString(qr.createSvgTag({ cellSize: 4, margin: 2, scalable: true }), 'image/svg+xml').documentElement;
    kok.querySelector('[data-qr]')!.replaceChildren(document.importNode(svg, true));
    kok.querySelector('[data-anahtar]')!.textContent = r.anahtar;
    bolum('dogrula');
    kok.querySelector<HTMLInputElement>('#dkod')!.focus();
  };

  const kurulum = kok.querySelector<HTMLFormElement>('[data-bolum="kurulum"]')!;
  kurulum.addEventListener('submit', (e) => {
    e.preventDefault();
    formTemizle(kurulum);
    const d = formNesnesi(kurulum);
    if (d.sifre !== kurulum.querySelector<HTMLInputElement>('#sifre2')!.value)
      return formHatasi(kurulum, new ApiError(400, 'Şifreler aynı değil.', 'Şifre tekrar'));
    mesgul(kurulum.querySelector('button'), async () => {
      try {
        qrGoster(await api('POST', '/yonetim/kurulum', d));
      } catch (err) {
        formHatasi(kurulum, err);
      }
    });
  });

  const sifirla = kok.querySelector<HTMLFormElement>('[data-sifirla]')!;
  sifirla.addEventListener('submit', (e) => {
    e.preventDefault();
    formTemizle(sifirla);
    mesgul(sifirla.querySelector('button'), async () => {
      try {
        qrGoster(await api('POST', '/yonetim/iki-adim-sifirla', formNesnesi(sifirla)));
      } catch (err) {
        formHatasi(sifirla, err);
      }
    });
  });

  const dogrula = kok.querySelector<HTMLFormElement>('[data-bolum="dogrula"]')!;
  dogrula.addEventListener('submit', (e) => {
    e.preventDefault();
    formTemizle(dogrula);
    mesgul(dogrula.querySelector('button'), async () => {
      try {
        await api('POST', '/yonetim/kurulum/dogrula', { bilet, kod: kok.querySelector<HTMLInputElement>('#dkod')!.value });
        location.replace('/yonetim/');
      } catch (err) {
        formHatasi(dogrula, err);
      }
    });
  });

  durumBandi();
  api<{ hazir: boolean; kurulumGerekli: boolean; kodTanimli: boolean }>('GET', '/yonetim/durum')
    .then((d) => {
      if (!d.hazir || !d.kodTanimli) bolum('ayar');
      else if (d.kurulumGerekli) bolum('kurulum');
      else bolum('tamam');
    })
    .catch((e) => {
      kok.querySelector<HTMLElement>('[data-yukleniyor]')!.textContent = e.message;
    });
</script>

<style>
  h2 {
    font-size: 1.3rem;
    margin: 18px 0 8px;
  }
  .kurulum-adim {
    display: grid;
    gap: 14px;
    padding-left: 1.2em;
    margin: 0 0 12px;
  }
  code {
    background: var(--sage-50);
    padding: 0.1em 0.4em;
    border-radius: 6px;
  }
</style>
