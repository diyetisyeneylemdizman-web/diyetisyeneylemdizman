---
import PortalLayout from '../../../layouts/PortalLayout.astro';
---

<PortalLayout title="Diyetisyen Girişi" alan="yonetim">
  <div class="auth">
    <div class="card auth-kart">
      <h1>Diyetisyen Girişi</h1>
      <form class="form-grid" novalidate data-adim1>
        <p class="form-hata" data-form-hata hidden role="alert"></p>
        <div class="field">
          <label for="eposta">E-posta</label>
          <input class="input" id="eposta" name="eposta" type="email" autocomplete="username" required data-alan="E-posta" />
        </div>
        <div class="field">
          <label for="sifre">Şifre</label>
          <input class="input" id="sifre" name="sifre" type="password" autocomplete="current-password" required />
        </div>
        <button type="submit" class="btn btn-primary btn-block">Devam</button>
      </form>
      <form class="form-grid" novalidate data-adim2 hidden>
        <p class="form-hata" data-form-hata hidden role="alert"></p>
        <p class="bilgi-kutu">Telefonunuzdaki doğrulama uygulamasında (Google Authenticator vb.) görünen 6 haneli kodu yazın.</p>
        <div class="field">
          <label for="kod">Doğrulama Kodu</label>
          <input
            class="input"
            id="kod"
            name="kod"
            inputmode="numeric"
            autocomplete="one-time-code"
            maxlength="6"
            pattern="[0-9]{6}"
            required
            data-alan="Doğrulama kodu"
          />
        </div>
        <button type="submit" class="btn btn-primary btn-block">Giriş Yap</button>
      </form>
      <p class="form-alt">
        <a href="/yonetim/kurulum/">İlk kurulum</a> · <a href="/yonetim/kurulum/#sifirla">Telefonumu değiştirdim / kaybettim</a>
      </p>
    </div>
  </div>
</PortalLayout>

<script>
  import { api, durumBandi, formHatasi, formTemizle, mesgul } from '../../../scripts/portal/lib';

  durumBandi();
  api('GET', '/yonetim/ben')
    .then(() => location.replace('/yonetim/'))
    .catch(() => {});

  const f1 = document.querySelector<HTMLFormElement>('[data-adim1]')!;
  const f2 = document.querySelector<HTMLFormElement>('[data-adim2]')!;
  let bilet = '';

  f1.addEventListener('submit', (e) => {
    e.preventDefault();
    formTemizle(f1);
    const d = new FormData(f1);
    mesgul(f1.querySelector('button'), async () => {
      try {
        const r = await api<{ bilet: string }>('POST', '/yonetim/giris', { eposta: d.get('eposta'), sifre: d.get('sifre') });
        bilet = r.bilet;
        f1.hidden = true;
        f2.hidden = false;
        f2.querySelector<HTMLInputElement>('#kod')!.focus();
      } catch (err) {
        formHatasi(f1, err);
      }
    });
  });

  f2.addEventListener('submit', (e) => {
    e.preventDefault();
    formTemizle(f2);
    const kod = f2.querySelector<HTMLInputElement>('#kod')!.value;
    mesgul(f2.querySelector('button'), async () => {
      try {
        await api('POST', '/yonetim/giris/dogrula', { bilet, kod });
        location.replace('/yonetim/');
      } catch (err: any) {
        if (err?.status === 400 && /süresi/.test(err.message)) {
          f2.hidden = true;
          f1.hidden = false;
        }
        formHatasi(f2.hidden ? f1 : f2, err);
      }
    });
  });
</script>
