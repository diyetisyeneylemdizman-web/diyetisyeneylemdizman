---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import AydinlatmaYerel from '../components/kvkk/AydinlatmaYerel.astro';
import AydinlatmaTakibim from '../components/kvkk/AydinlatmaTakibim.astro';
import { portalBelgeleri, takibimAcik } from '../data/portal';
// NOT: Bu metin genel bir şablondur. Bir hukukçu tarafından gözden geçirilmesi önerilir.
// Metnin içeriği src/components/kvkk/ klasöründedir:
//   - AydinlatmaYerel.astro   → şu anki düzen (takibimAcik = false): danışan verisi sunucuya gönderilmez
//   - AydinlatmaTakibim.astro → Takibim ve şifreli randevu kutusu açıkken (takibimAcik = true)
// Kişisel veri işleyişi değiştiğinde ilgili metin güncellenmeli ve src/data/portal.ts içindeki "aydinlatma" sürümü ve
// tarihi değiştirilmelidir.
const b = portalBelgeleri.aydinlatma;
const guncelleme = b.guncelleme.split('-').reverse().join('.');
---

<BaseLayout
  title="KVKK Aydınlatma Metni"
  description={takibimAcik
    ? 'Diyetisyen Eylem Dizman internet sitesi, randevu talepleri, danışan kayıtları ve Takibim kapsamında kişisel verilerin işlenmesine ilişkin aydınlatma metni.'
    : 'Diyetisyen Eylem Dizman internet sitesi, randevu talepleri ve danışan kayıtları kapsamında kişisel verilerin işlenmesine ilişkin aydınlatma metni.'}
>
  <PageHero title="KVKK Aydınlatma Metni" eyebrow="Kişisel Verilerin Korunması" crumbs={[{ label: 'KVKK Aydınlatma Metni' }]} />

  <section class="section">
    <div class="container-narrow prose">
      <p class="surum">Son güncelleme: {guncelleme} · Sürüm {b.surum}</p>
      {takibimAcik ? <AydinlatmaTakibim /> : <AydinlatmaYerel />}
    </div>
  </section>
</BaseLayout>

<style>
  .surum {
    color: var(--ink-3);
    font-size: 0.9rem;
  }
</style>
